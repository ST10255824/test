rules_version = '2';

// Cloud Storage for Firebase — Part 1 section 9.3.9: "stores product images, served via
// Firebase's CDN." Product photos are public-read (they're shown pre-login on shared links /
// marketing) but only Store Managers/Admins can upload or replace them.
service firebase.storage {
  match /b/{bucket}/o {
    function hasAnyRole(roles) {
      return request.auth != null && request.auth.token.role in roles;
    }

    match /productImages/{storeId}/{imageId} {
      allow read: if true;
      allow write: if hasAnyRole(['ADMIN', 'MANAGER']) && request.resource.size < 5 * 1024 * 1024
                      && request.resource.contentType.matches('image/.*');
    }

    match /deliveryProof/{orderId}/{imageId} {
      // Doorstep photo confirmation (Part 1 US-22) — only the assigned driver may upload,
      // and only the order's customer/driver/admin may ever read it back.
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024
                      && request.resource.contentType.matches('image/.*');
    }
  }
}
