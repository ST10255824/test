{
  "name": "mackson-delivery-functions",
  "version": "1.0.0",
  "description": "Cloud Functions backend for Mackson's Supermarket delivery platform",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "serve": "npm run build && cd .. && firebase emulators:start --only functions,firestore,database,auth,storage",
    "seed": "TS_NODE_TRANSPILE_ONLY=true FIRESTORE_EMULATOR_HOST=localhost:8080 FIREBASE_DATABASE_EMULATOR_HOST=localhost:9000 GCLOUD_PROJECT=demo-mackson-delivery FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 ts-node seed/seedEmulator.ts",
    "seed:production": "TS_NODE_TRANSPILE_ONLY=true CONFIRM_PRODUCTION_SEED=yes ts-node seed/seedProduction.ts",
    "deploy": "cd .. && firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.3.1",
    "firebase-functions": "^5.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "private": true
}
